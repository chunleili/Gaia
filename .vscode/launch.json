
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(msvc) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            // Resolved by CMake Tools:
            "program": "${workspaceFolder}/build/Debug/PBDDynamics.exe",
            "args": ["D:/dev/Gaia/Simulator/PBDDynamics/ParameterGen/Examples/Models.json ",
             "D:/dev/Gaia/Simulator/PBDDynamics/ParameterGen/Examples/Parameters.json",
              "D:/dev/Gaia/result",
              "-R",
              "${workspaceFolder}"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    // add the directory where our target was built to the PATHs
                    // it gets resolved by CMake Tools:
                    "name": "PATH",
                    "value": "${env:PATH}:${command:cmake.getLaunchTargetDirectory}"
                },
            ],
            "console": "internalConsole",
        }
    ]
}
