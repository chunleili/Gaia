
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug PBDDynamics_d",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/PBDDynamics_d.exe",
            "args": ["${workspaceFolder}/Simulator/PBDDynamics/ParameterGen/Examples/Models2.json",
                "${workspaceFolder}/Simulator/PBDDynamics/ParameterGen/Examples/Parameters.json",
              "${workspaceFolder}/result",
              "-R",
              "${workspaceFolder}"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    // add the directory where our target was built to the PATHs
                    // it gets resolved by CMake Tools:
                    "name": "PATH",
                    "value": "${env:PATH}:${command:cmake.getLaunchTargetDirectory}"
                },
            ],
            "console": "internalConsole",
        }
    ]
}
